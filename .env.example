# Sitenin kanonik adresi (sonunda / olmadan). Canonical, sitemap, OG ve yapılandırılmış veride kullanılır.
NEXT_PUBLIC_SITE_URL=https://www.mes.com.tr

# Teklif formunun JSON olarak POST edileceği adres (Formspree, Make, Zapier, n8n veya kendi sunucunuz).
# Boş bırakılırsa form "gönderildi" demez; ziyaretçiyi e-posta / WhatsApp ile iletmeye yönlendirir.
QUOTE_WEBHOOK_URL=

# İsteğe bağlı: webhook isteğine "Authorization: Bearer <değer>" başlığı eklenir.
QUOTE_WEBHOOK_TOKEN=
